{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Micropaste",
  "version": "0.3.3",
  "identifier": "com.abou.micropaste",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Micropaste",
        "width": 800,
        "height": 452,
        "minWidth": 600,
        "minHeight": 300,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMDhFMzFBOEU1MTRBRTMKUldUalNsR09HdU1JK3hNQzVrcDhraGNoZ05iVkxDaEs2UkNRSUFncnBwb3laSkc3YlVCZFRpOVQK",
      "endpoints": ["https://github.com/davidabou/micropaste/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

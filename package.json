{
  "name": "micropaste",
  "type": "module",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "site:dev": "bun run --cwd site dev",
    "site:typecheck": "bun run --cwd site typecheck",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "bumpp"
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.2",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "motion-v": "^2.11.0",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.45",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/gravity-ui": "^1.2.15",
    "@nuxt/eslint": "^1.17.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx nano-staged",
    "commit-msg": "bunx commitlint --edit $1"
  },
  "nano-staged": {
    "*.{ts,vue,js,mjs,json,md,yml,yaml}": "eslint --fix"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  }
}
